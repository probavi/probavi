{"ok":true,"payload":{"adapter_version":"0.3.0","checks":{"row_count":{"statement":"{{table}}/count"},"table_exists":{"statement":"{{table}}/count"}},"engine":{"name":"chroma"},"identifier":{"close":"","open":"","separator":"."},"name":"chroma","protocol_versions":["probavi-adapter/1","probavi-adapter/0"],"sources":[{"capabilities":{"pitr":false},"kind":"chroma_data_tar"},{"capabilities":{"pitr":false},"kind":"chroma_data"}],"sql_runner":{"argv":["bash","-c","set -u\nhttp() {\n  local m=$1 p=$2 b=${3-} line\n  exec 3\u003c\u003e/dev/tcp/127.0.0.1/8000 || { echo 'chroma is not listening on 8000' \u003e\u00262; return 9; }\n  { printf '%s %s HTTP/1.0\\r\\nHost: localhost\\r\\n' \"$m\" \"$p\"\n    [ -n \"$b\" ] \u0026\u0026 printf 'Content-Type: application/json\\r\\nContent-Length: %d\\r\\n' \"${#b}\"\n    printf '\\r\\n%s' \"$b\"; } \u003e\u00263\n  while IFS= read -r line \u003c\u00263; do case \"$line\" in ''|$'\\r') break;; esac; done\n  cat \u003c\u00263\n  exec 3\u003c\u0026-\n}\n\ntext=$2\nspec=${text%% *}\nbody=''\ncase \"$text\" in *' '*) body=${text#* } ;; esac\ncase \"$spec\" in\n  /*) path=$spec ;;\n  *)\n    coll=${spec%%/*}\n    rest=''\n    case \"$spec\" in */*) rest=/${spec#*/} ;; esac\n    case \"$coll\" in\n      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*-*-*-*) ;;\n      *)\n        id=$(http GET /api/v2/tenants/default_tenant/databases/default_database/collections/\"$coll\" |\n             grep -oE '\"id\":\"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\"' |\n             head -1 | cut -d'\"' -f4)\n        if [ -z \"$id\" ]; then\n          printf 'no collection named %s in the restored database\\n' \"$coll\" \u003e\u00262\n          exit 1\n        fi\n        coll=$id ;;\n    esac\n    path=/api/v2/tenants/default_tenant/databases/default_database/collections/$coll$rest ;;\nesac\nexec 3\u003c\u003e/dev/tcp/127.0.0.1/8000 || { echo 'chroma is not listening on 8000' \u003e\u00262; exit 1; }\n{ if [ -n \"$body\" ]; then\n    printf 'POST %s HTTP/1.0\\r\\nHost: localhost\\r\\n' \"$path\"\n    printf 'Content-Type: application/json\\r\\nContent-Length: %s\\r\\n\\r\\n' \"${#body}\"\n    printf '%s' \"$body\"\n  else\n    printf 'GET %s HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' \"$path\"\n  fi\n} \u003e\u00263\nresp=$(cat \u003c\u00263)\nexec 3\u003c\u0026-\nstatus=$(printf '%s' \"$resp\" | head -1 | cut -d' ' -f2)\npayload=$(printf '%s' \"$resp\" | awk 'BEGIN{h=1} h \u0026\u0026 /^\\r?$/ {h=0; next} !h {print}')\ncase \"$status\" in\n  2*) ;;\n  *) printf 'chroma answered %s\\n' \"${status:-nothing}\" \u003e\u00262\n     printf '%s' \"$payload\" | head -c 300 \u003e\u00262; exit 1 ;;\nesac\nprintf '%s\\n' \"$payload\"","bash","{{database}}","{{sql}}"]},"verbs_required":["exec","put_file"]},"protocol":"probavi-adapter/0","request_id":"r-test"}
