{"ok":true,"payload":{"adapter_version":"0.1.0","engine":{"name":"h2"},"name":"h2","protocol_versions":["probavi-adapter/0"],"sources":[{"capabilities":{"pitr":false},"kind":"h2_db"},{"capabilities":{"pitr":false},"kind":"h2_db_dir"},{"capabilities":{"pitr":false},"kind":"h2_backup"},{"capabilities":{"pitr":false},"kind":"h2_backup_dir"}],"sql_runner":{"argv":["sh","-c","out=$(java -cp /opt/h2/h2.jar org.h2.tools.Shell -url \"jdbc:h2:file:$1;IFEXISTS=TRUE\" -user \"$2\" -password \"${PROBAVI_H2_PASSWORD-}\" -sql \"$3\" 2\u003e\u00261)\nstatus=$?\nif [ \"$status\" -ne 0 ]; then printf '%s\\n' \"$out\" \u003e\u00262; exit \"$status\"; fi\nif printf '%s\\n' \"$out\" | grep -q '^Error: '; then printf '%s\\n' \"$out\" \u003e\u00262; exit 1; fi\nprintf '%s\\n' \"$out\" | sed -e '1d' -e '$d'","sh","{{database}}","{{user}}","{{sql}}"],"env":{"PROBAVI_H2_PASSWORD":"{{password}}"}},"verbs_required":["exec","put_file"]},"protocol":"probavi-adapter/0","request_id":"r-test"}
