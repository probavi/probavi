{"ok":true,"payload":{"adapter_version":"0.5.0","engine":{"name":"tdengine"},"name":"tdengine","protocol_versions":["probavi-adapter/0"],"sources":[{"capabilities":{"pitr":false},"kind":"taosdump"},{"capabilities":{"pitr":false},"kind":"taosdump_dir"},{"capabilities":{"pitr":false},"kind":"taosdump_tar"}],"sql_runner":{"argv":["bash","-c","set -u\nident='\"[A-Za-z_][A-Za-z0-9_]*\"'\ntable=\"$ident(\\.$ident)?\"\ngenerated=\"^SELECT count\\(\\*\\) FROM $table( WHERE 1=0)?$|^SELECT max\\($ident\\) FROM $table$\"\nname='[A-Za-z_][A-Za-z0-9_]*'\nnewest=\"^SELECT max\\(\\\"($name)\\\"\\) FROM \\\"($name)\\\"\\.\\\"($name)\\\"$\"\nbt='`'\nstmt=$1\nif printf '%s' \"$stmt\" | grep -Eq \"$generated\"; then\n  stmt=$(printf '%s' \"$stmt\" | tr '\"' \"$bt\")\nfi\nif [[ $1 =~ $newest ]]; then\n  col=${BASH_REMATCH[1]} db=${BASH_REMATCH[2]} tbl=${BASH_REMATCH[3]}\n  type=$(curl -sf -u root:taosdata --data-binary \"SELECT col_type FROM information_schema.ins_columns WHERE db_name = '$db' AND table_name = '$tbl' AND col_name = '$col'\" \"http://127.0.0.1:6041/rest/sql\" | sed -n 's/.*\"data\":\\[\\[\"\\([A-Z]*\\)\"\\]\\].*/\\1/p')\n  if [ \"$type\" = TIMESTAMP ]; then\n    stmt=\"SELECT CAST(max(CAST($bt$col$bt AS BIGINT)) AS TIMESTAMP) FROM $bt$db$bt.$bt$tbl$bt\"\n  fi\nfi\nout=$(curl -s -w '\\n%{http_code}' -u root:taosdata --data-binary \"$stmt\" \"http://127.0.0.1:6041/rest/sql\") || {\n  echo \"the engine could not be reached\" \u003e\u00262; exit 1; }\ncode=${out##*$'\\n'}\nbody=${out%$'\\n'*}\n[ \"$code\" = 200 ] || { printf '%s\\n' \"$body\" \u003e\u00262; exit 1; }\ncase \"$body\" in\n  *'\"code\":0'*) ;;\n  *) printf '%s\\n' \"$body\" \u003e\u00262; exit 1;;\nesac\nprintf '%s\\n' \"$body\" |\n  sed -n 's/.*\"data\":\\[\\[\\(.*\\)\\]\\].*/\\1/p' |\n  sed 's/^\"//; s/\"$//; s/\",\"/\\t/g'","bash","{{sql}}"],"env":{}},"verbs_required":["exec","put_file"]},"protocol":"probavi-adapter/0","request_id":"r-test"}
