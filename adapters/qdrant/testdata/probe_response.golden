{"ok":true,"payload":{"adapter_version":"0.1.0","engine":{"name":"qdrant"},"name":"qdrant","protocol_versions":["probavi-adapter/0"],"sources":[{"capabilities":{"pitr":false},"kind":"qdrant_snapshot"},{"capabilities":{"pitr":false},"kind":"qdrant_snapshot_dir"},{"capabilities":{"pitr":false},"kind":"qdrant_full_snapshot"},{"capabilities":{"pitr":false},"kind":"qdrant_full_snapshot_dir"}],"sql_runner":{"argv":["bash","-c","set -u\ncoll=$1; text=$2\npath=${text%% *}\nbody=''\ncase \"$text\" in *' '*) body=${text#* } ;; esac\ncase \"$path\" in /*) ;; *) path=/collections/$coll/$path ;; esac\nexec 3\u003c\u003e/dev/tcp/127.0.0.1/6333 || { echo 'qdrant is not listening on 6333' \u003e\u00262; exit 1; }\n{\n  if [ -n \"$body\" ]; then\n    printf 'POST %s HTTP/1.1\\r\\n' \"$path\"\n    printf 'Host: localhost\\r\\nConnection: close\\r\\nContent-Type: application/json\\r\\n'\n    printf 'Content-Length: %s\\r\\n\\r\\n' \"${#body}\"\n    printf '%s' \"$body\"\n  else\n    printf 'GET %s HTTP/1.1\\r\\n' \"$path\"\n    printf 'Host: localhost\\r\\nConnection: close\\r\\n\\r\\n'\n  fi\n} \u003e\u00263\nresp=$(cat \u003c\u00263)\nexec 3\u003e\u0026-\nstatus=$(printf '%s' \"$resp\" | head -1 | cut -d' ' -f2)\npayload=$(printf '%s' \"$resp\" | awk 'BEGIN{h=1} h \u0026\u0026 /^\\r?$/ {h=0; next} !h {print}')\ncase \"$status\" in\n  2*) ;;\n  *) printf 'qdrant answered %s\\n' \"${status:-nothing}\" \u003e\u00262\n     printf '%s' \"$payload\" | head -c 300 \u003e\u00262; exit 1 ;;\nesac\nn=$(printf '%s' \"$payload\" | grep -o '\"\\(points_count\\|count\\)\":[0-9][0-9]*' | head -1 | sed 's/.*://')\nif [ -n \"$n\" ]; then printf '%s\\n' \"$n\"; else printf '%s\\n' \"$payload\"; fi","bash","{{database}}","{{sql}}"]},"verbs_required":["exec","put_file"]},"protocol":"probavi-adapter/0","request_id":"r-test"}
