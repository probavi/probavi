{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probavi.dev/schemas/adapter/probe-response.json",
  "title": "Probavi adapter protocol v0 — probe response payload",
  "description": "Adapter identity, protocol versions, supported source kinds, and capabilities (adapter-protocol.md §6.1).",
  "$comment": "Derived from docs/adapter-protocol.md, which is normative. On any disagreement the markdown document wins.",
  "type": "object",
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "adapter_version": { "type": "string", "minLength": 1 },
    "protocol_versions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^probavi-adapter/(0|[1-9][0-9]*)$" },
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "probavi-adapter/0" },
      "description": "Every protocol version the adapter speaks. A payload valid against this v0 schema necessarily includes probavi-adapter/0."
    },
    "engine": {
      "type": "object",
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "required": ["name"],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "capabilities": {
            "type": "object",
            "properties": {
              "pitr": { "type": "boolean" },
              "select": {
                "type": "boolean",
                "description": "v1 (\u00a76.1.2). Whether the kind chooses one backup out of a directory and honours source.select. Absent means not declared, which is not the same as false."
              }
            },
            "required": ["pitr"],
            "additionalProperties": false
          }
        },
        "required": ["kind", "capabilities"],
        "additionalProperties": false
      }
    },
    "sql_runner": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "contains": { "const": "{{sql}}" },
          "description": "Declarative template; {{sql}} must be its own argv element (§6.1)."
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["argv", "env"],
      "additionalProperties": false
    },
    "verbs_required": {
      "type": "array",
      "items": { "enum": ["exec", "put_file"] },
      "uniqueItems": true
    },
    "identifier": {
      "type": "object",
      "description": "v1 (\u00a76.1.1). How this engine spells a qualified name. Absent means the SQL-standard default the core has always applied: \" \" and a dot.",
      "properties": {
        "open": { "type": "string", "maxLength": 2 },
        "close": { "type": "string", "maxLength": 2 },
        "separator": { "type": "string", "minLength": 1, "maxLength": 1 }
      },
      "required": ["open", "close", "separator"],
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "description": "v1 (\u00a76.1.1). The statement for a named built-in check kind, in whatever language this engine's sql_runner takes. Keys are built-in check kinds the core publishes; an undeclared kind is composed by the core as in v0.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "statement": { "type": "string", "minLength": 1 }
        },
        "required": ["statement"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "adapter_version", "protocol_versions", "engine", "sources", "sql_runner", "verbs_required"],
  "additionalProperties": false
}
