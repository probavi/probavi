        "exit_codes": [
          {
            "code": 0,
            "meaning": "backup proven restorable"
          },
          {
            "code": 1,
            "meaning": "recoverability failure (backup, restore, or check)"
          },
          {
            "code": 2,
            "meaning": "infrastructure error or cancelled"
          },
          {
            "code": 3,
            "meaning": "usage or setup error"
          },
          {
            "code": 5,
            "meaning": "evidence record could not be written"
