  "sandbox_providers": [
    {
      "id": "docker",
      "name": "Docker",
      "status": "experimental",
      "params": [
        {
          "id": "image",
          "required": true,
          "default": null,
          "doc": "Sandbox image; it must contain the engine and the restore tooling the adapter drives."
        },
        {
          "id": "network",
          "required": false,
          "default": "none",
          "doc": "Docker network the sandbox joins."
        },
        {
          "id": "memory",
          "required": false,
          "default": null,
          "doc": "Container memory limit (docker run --memory)."
        },
        {
          "id": "cpus",
          "required": false,
          "default": null,
          "doc": "Container CPU limit (docker run --cpus)."
        },
        {
          "id": "command",
          "required": false,
          "default": null,
          "doc": "Container command override, split on whitespace and executed without a shell — for engines the adapter starts itself."
        },
        {
          "id": "env.<NAME>",
          "required": false,
          "default": null,
          "doc": "Environment variable set inside the sandbox."
        }
      ],
      "isolation": {
        "network_default": "none",
        "published_ports": false,
        "storage": "container filesystem and anonymous volumes, removed with the container",
        "forced_teardown": true,
        "orphan_sweep": "host- and pid-scoped labels, swept at drill start",
        "external_backstop": null
      },
      "constraints": [
        "Requires a reachable Docker daemon; the docker CLI is driven directly, never the SDK.",
        "Remote daemons work unchanged through the CLI's native SSH transport (DOCKER_HOST=ssh://user@host). The endpoint stays in the environment: sandbox params are recorded verbatim in signed evidence, and connection details must never appear there.",
        "Publishing ports is not expressible: the provider never emits -p."
      ],
      "verified_against": [
        "local Docker daemon (CI integration suite)",
        "remote daemon over the docker CLI SSH transport (CI integration suite)"
      ],
      "docs": null
    },
    {
      "id": "k8s",
      "name": "Kubernetes Job",
      "status": "experimental",
      "params": [
        {
          "id": "image",
          "required": true,
          "default": null,
          "doc": "Sandbox image; it must contain the engine and the restore tooling the adapter drives."
        },
        {
          "id": "namespace",
          "required": false,
          "default": "default",
          "doc": "Namespace the Job is created in."
        },
        {
          "id": "memory",
          "required": false,
          "default": null,
          "doc": "Container memory request and limit, set equal so the pod is guaranteed."
        },
        {
          "id": "cpus",
          "required": false,
          "default": null,
          "doc": "Container CPU request and limit, set equal so the pod is guaranteed."
        },
        {
          "id": "command",
          "required": false,
          "default": null,
          "doc": "Container command override, split on whitespace — for engines the adapter starts itself."
        },
        {
          "id": "env.<NAME>",
          "required": false,
          "default": null,
          "doc": "Environment variable set inside the sandbox."
        }
      ],
      "isolation": {
        "network_default": null,
        "published_ports": false,
        "storage": "pod filesystem, deleted with the Job",
        "forced_teardown": true,
        "orphan_sweep": "host- and pid-scoped labels, swept at drill start",
        "external_backstop": "cluster-side: activeDeadlineSeconds 7200 then TTL 600s, so a sandbox dies even if the drill host does"
      },
      "constraints": [
        "Requires a working kubectl context with rights to create, exec into, and delete Jobs in the target namespace; the kubectl CLI is driven directly, never client-go.",
        "Network isolation is the cluster's job: the pod carries the sandbox label so a NetworkPolicy can select it. There is no pod-level equivalent of the docker provider's --network none.",
        "The pod runs with no service-account token, no service links, and the RuntimeDefault seccomp profile.",
        "Per-command environment values reach the command through stdin, never the command line: kubectl exec has no environment flag, and a value in argv would be readable from the process list on the drill host and inside the pod. Requires sh in the image, as put_file already does."
      ],
      "verified_against": [
        "kind cluster (CI integration suite)"
      ],
      "docs": null
    },
    {
      "id": "remotehost",
      "name": "Bare host over SSH",
      "status": "experimental",
      "params": [
        {
          "id": "workspace_root",
          "required": false,
          "default": "/var/lib/probavi-drills",
          "doc": "Absolute path on the target holding per-drill workspaces."
        },
        {
          "id": "memory",
          "required": false,
          "default": null,
          "doc": "MemoryMax of the drill's transient systemd slice (systemd size suffixes)."
        },
        {
          "id": "cpus",
          "required": false,
          "default": null,
          "doc": "CPUQuota of the drill's transient systemd slice (decimal CPU count)."
        }
      ],
      "isolation": {
        "network_default": null,
        "published_ports": false,
        "storage": "per-drill workspace under the workspace root, mode 0700, deleted (not shredded) at teardown",
        "forced_teardown": true,
        "orphan_sweep": "host-scoped owner markers under the workspace root, swept at drill start",
        "external_backstop": "target-side transient systemd timer stops the slice and removes the workspace 7200s after creation, so restored data does not outlive a vanished drill host"
      },
      "constraints": [
        "No container isolation. A dedicated drill host is a premise of this provider, not a recommendation.",
        "systemd 244 or newer on the target, probed at first contact.",
        "Engine and tool versions are whatever the target host has installed; the version match a sandbox image guarantees does not apply here.",
        "Requires the right to run transient systemd units as the drill user — the polkit rule the README ships.",
        "Per-command environment values reach the command through stdin, never the remote command line: ssh has no environment channel independent of the target's AcceptEnv, and a value in argv would be readable from the process list on both hosts.",
        "The target is named by the PROBAVI_SSH_TARGET environment variable only, never in drill config: sandbox params are recorded verbatim in signed evidence, and connection details must never appear there."
      ],
      "verified_against": [
        "systemd host over the OpenSSH CLI (CI integration suite)"
      ],
      "docs": "docs/sandbox-bare-host.md"
    }
  ],
