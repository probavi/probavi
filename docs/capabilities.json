          },
          {
            "id": "--to-env",
            "required": false,
            "repeatable": false,
            "doc": "Environment variable holding the destination URL; use this when the URL carries a token."
          },
          {
            "id": "--path",
            "required": false,
            "repeatable": false,
            "doc": "Path the log is sent under, appended to the destination URL; defaults to the log file's base name."
          },
          {
            "id": "--token-env",
            "required": false,
            "repeatable": false,
            "doc": "Environment variable holding the bearer token; defaults to PROBAVI_PUSH_TOKEN."
          },
          {
            "id": "--allow-unauthenticated",
            "required": false,
            "repeatable": false,
            "doc": "Send no Authorization header; mutually exclusive with --token-env."
          },
          {
            "id": "--secret-env",
            "required": false,
            "repeatable": false,
            "doc": "Environment variable holding the HMAC secret for body signing; absent means unsigned."
