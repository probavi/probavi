      {
        "id": "push",
        "name": "probavi push",
        "status": "experimental",
        "summary": "Send an evidence log to a URL: the whole file, unchanged, as application/x-ndjson. A copy — the log is never modified.",
        "flags": [
          {
            "id": "--log",
